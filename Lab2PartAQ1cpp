#include <iostream>
using namespace std;
int product(int A, int B); //prototype
int main() {
    int A, B;

    cout << "Enter two integers: ";
    cin >> A >> B;
    product(A, B);
}

int product(int A, int B) {
    if (A == 0 || B == 0) {
        return 0;
    } else if (A > 0 && B > 0) {
        return A + product(A, B - 1);
    } else if (A < 0 && B < 0) {
        return -A + product(-A, B + 1);
    } else if (A < 0 && B > 0) {
        return -A + product(-A, B - 1);
    } else if (A > 0 && B < 0) {
        return -A + product(A, B + 1);
    }
}


